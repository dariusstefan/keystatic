---
import { type Version, VERSIONS, getModuleUrl } from '~/config/module-versions';

interface Props {
  module: string;
  currentSlug: string;
  versions?: Version[];
}

const { module, currentSlug, versions = VERSIONS } = Astro.props;
const current = versions.find((v) => v.slug === currentSlug);
---

<nav class="version-selector not-content" aria-label="Version">
  <details class="vs-dropdown">
    <summary class="vs-trigger">
      {current?.label ?? currentSlug}
      <svg class="vs-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <ul class="vs-list" role="list">
      {versions.map((v) => {
        const isCurrent = v.slug === currentSlug;
        return (
          <li>
            <a
              href={getModuleUrl(module, v.slug)}
              class:list={['vs-item', { 'vs-item--active': isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              {v.label}
            </a>
          </li>
        );
      })}
    </ul>
  </details>
</nav>

<script>
  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.vs-dropdown[open]').forEach((el) => {
      if (!el.contains(e.target as Node)) el.removeAttribute('open');
    });
  });
</script>

<style>
  .version-selector {
    display: flex;
    align-items: center;
    font-size: 0.8125rem;
  }

  .vs-dropdown {
    position: relative;
  }

  .vs-dropdown[open] .vs-chevron {
    transform: rotate(180deg);
  }

  .vs-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    cursor: pointer;
    list-style: none;
    background: var(--sl-color-accent-low);
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
    font-size: 0.8125rem;
    transition: background 0.12s, border-color 0.12s;
    user-select: none;
  }

  .vs-trigger::-webkit-details-marker { display: none; }

  .vs-trigger:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-accent-low);
  }

  .vs-chevron {
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  .vs-list {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.375rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.625rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    min-width: 7rem;
  }

  .vs-item {
    display: block;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    border: 1px solid transparent;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
    font-weight: 500;
    white-space: nowrap;
  }

  .vs-item:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .vs-item--active {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
    cursor: default;
    pointer-events: none;
  }
</style>
