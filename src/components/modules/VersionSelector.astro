---
import { VERSIONS, getModuleUrl } from '~/config/module-versions';

interface Props {
  module: string;
  version: string;
}

const { module, version } = Astro.props;
---

<nav class="version-selector not-content" aria-label="Version">
  <span class="vs-label">Version</span>
  <ul class="vs-list" role="list">
    {VERSIONS.map((v) => {
      const isCurrent = v.branch === version;
      return (
        <li>
          <a
            href={getModuleUrl(module, v.branch)}
            class:list={['vs-item', { 'vs-item--active': isCurrent }]}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {v.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .version-selector {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin: 1rem 0 1.75rem;
    font-size: 0.8125rem;
  }

  .vs-label {
    color: var(--sl-color-gray-3);
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .vs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vs-item {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    transition: background 0.12s, color 0.12s, border-color 0.12s;
    font-weight: 500;
  }

  .vs-item:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .vs-item--active {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
    cursor: default;
    pointer-events: none;
  }
</style>
