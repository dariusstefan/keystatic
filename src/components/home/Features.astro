---
import { Icon } from 'astro-icon/components';

const features = [
  { icon: 'tabler:route', title: 'SIP routing', description: 'Programmable routing engine with a flexible C-like scripting language.' },
  { icon: 'tabler:shield-lock', title: 'Carrier security', description: 'TLS, SRTP, anti-flooding, fraud detection, blacklists.' },
  { icon: 'tabler:topology-star', title: 'Clustering', description: 'Geo-distributed deployments, replication, HA failover.' },
  { icon: 'tabler:phone-call', title: 'Voice, video, IM', description: 'Presence, B2BUA, registrar, SMS gateway, media handling.' },
  { icon: 'tabler:chart-line', title: 'Observability', description: 'Live profiling, metrics, tracing, MI and event interfaces.' },
  { icon: 'tabler:plug-connected', title: 'Extensible', description: '120+ modules, REST, MI, event interfaces, Perl/Java SDK.' },
];
---

<section class="not-content features-section">
  <div class="features-header">
    <p class="features-eyebrow">What it does</p>
    <h2 class="features-title">Built for production SIP at scale</h2>
  </div>

  <div class="features-grid">
    {
      features.map((f) => (
        <article class="feature-card">
          <div class="feature-icon"><Icon name={f.icon} /></div>
          <h3 class="feature-name">{f.title}</h3>
          <p class="feature-desc">{f.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .features-section {
    background: var(--color-base-200, #f3f3f3);
    
    padding: 4rem 1rem;
  }
  .features-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .features-eyebrow {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    opacity: 0.6;
    margin: 0 0 0.5rem;
  }
  .features-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin: 0;
  }
  .features-grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .features-grid { grid-template-columns: repeat(3, 1fr); } }
  .feature-card {
    border: 1px solid var(--color-base-300, #e5e5e5);
    border-radius: 0.75rem;
    padding: 1.5rem;
    background: var(--color-base-200, #f3f3f3);
    transition: border-color 0.15s;
  }
  .feature-card:hover { border-color: var(--color-primary, #7da82e); }
  .feature-icon { color: var(--color-primary, #7da82e); margin-bottom: 0.75rem; }
  .feature-icon svg { width: 2rem; height: 2rem; stroke-width: 1.5; }
  .feature-name { font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem; }
  .feature-desc { font-size: 0.875rem; opacity: 0.7; line-height: 1.5; margin: 0; }
</style>
