---
const summit = { year: 2026, city: 'Bucharest', url: '/community/summits' };
---

<section class="not-content cta-section">
  <h3 class="cta-title">Join the OpenSIPS Summit {summit.year}</h3>
  <p class="cta-sub">{summit.city} · Three days of talks, workshops, and community.</p>
  <a href={summit.url} class="cta-btn">Learn more</a>
</section>

<style>
  .cta-section {
    background: var(--color-base-200, #f3f3f3);
    text-align: center;
    padding: 3rem 1rem;
  }
  .cta-title { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem; }
  .cta-sub { opacity: 0.7; margin: 0 0 1.5rem; }
  .cta-btn {
    display: inline-block;
    background: var(--color-primary, #7da82e);
    color: var(--color-primary-content, #fff);
    padding: 0.625rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .cta-btn:hover { opacity: 0.9; }
</style>
