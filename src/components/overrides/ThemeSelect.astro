---
---

<starlight-theme-select>
  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" title="Toggle color theme">
    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
  <select aria-label="Select theme" class="sr-only-select" autocomplete="off">
    <option value="dark">Dark</option>
    <option value="light">Light</option>
    <option value="auto" selected>Auto</option>
  </select>
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';
  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme) {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function applyTheme(theme: Theme) {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
    updateIcon(theme);
  }

  function updateIcon(theme: Theme) {
    const resolved = theme === 'auto' ? getPreferredColorScheme() : theme;
    document.querySelectorAll<HTMLElement>('.theme-toggle').forEach((btn) => {
      btn.dataset.theme = resolved;
    });
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') applyTheme('auto');
  });

  document.addEventListener('DOMContentLoaded', () => {
    updateIcon(loadTheme());

    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = loadTheme();
        const next: Theme = current === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        // sync the hidden select
        const sel = btn.closest('starlight-theme-select')?.querySelector('select');
        if (sel) sel.value = next;
      });
    });
  });
</script>

<style>
  starlight-theme-select {
    display: flex;
    align-items: center;
  }
  .sr-only-select {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    border: 0;
  }
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    transition: color 0.15s, background 0.15s;
    width: 2rem;
    height: 2rem;
  }
  .theme-toggle:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-bg-sidebar);
  }
  .icon-sun, .icon-moon {
    position: absolute;
    transition: opacity 0.15s;
  }
  /* Light mode: show sun. Dark mode: show moon. */
  .theme-toggle[data-theme='light'] .icon-moon { opacity: 0; }
  .theme-toggle[data-theme='light'] .icon-sun  { opacity: 1; }
  .theme-toggle[data-theme='dark']  .icon-sun  { opacity: 0; }
  .theme-toggle[data-theme='dark']  .icon-moon { opacity: 1; }
  /* default (no data-theme yet) */
  .theme-toggle:not([data-theme]) .icon-moon { opacity: 0; }
  .theme-toggle:not([data-theme]) .icon-sun  { opacity: 1; }
</style>
