---
import type { Props } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from './ThemeSelect.astro';

const nav = [
  { label: 'About', href: '/about' },
  { label: 'Downloads', href: '/downloads' },
  { label: 'Documentation', href: '/documentation' },
  { label: 'Community', href: '/community' },
  { label: 'Training', href: '/training' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');

function isActive(href: string) {
  const h = href.replace(/\/$/, '');
  if (h === '') return currentPath === '';
  return currentPath === h || currentPath.startsWith(h + '/');
}
---

<div class="site-header not-content">
  <!-- Main bar -->
  <div class="header-bar">
    <a href="/" class="site-logo" aria-label="OpenSIPS home">
      <img class="logo-img logo-light" src="/opensips-logo.png" alt="OpenSIPS" height="32" />
      <img class="logo-img logo-dark" src="/opensips-dark.png" alt="" height="32" aria-hidden="true" />
    </a>

    <!-- Primary nav (collapses below 1060px) -->
    <nav class="main-nav" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right side controls -->
    <div class="header-right">
      <div class="search-wrap">
        <Search {...Astro.props} />
      </div>
      <div class="search-divider"></div>
      <div class="header-actions">
        <a href="https://github.com/OpenSIPS/opensips" target="_blank" rel="noopener" aria-label="GitHub" class="icon-btn social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/opensips/" target="_blank" rel="noopener" aria-label="LinkedIn" class="icon-btn social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.youtube.com/@OpenSIPS" target="_blank" rel="noopener" aria-label="YouTube" class="icon-btn social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <div class="divider"></div>
        <ThemeSelect {...Astro.props} />
        <button class="icon-btn menu-btn" aria-label="Open menu" id="mobile-menu-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile dropdown panel -->
  <div class="mobile-panel" id="mobile-nav" hidden>
    <nav class="mobile-nav-links">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['mobile-nav-link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    if (panel?.hasAttribute('hidden')) panel.removeAttribute('hidden');
    else panel?.setAttribute('hidden', '');
  });

  const setupTocIndicator = () => {
    const nav = document.querySelector('starlight-toc nav');
    if (!nav || nav.querySelector('.toc-active-indicator')) return;

    const indicator = document.createElement('span');
    indicator.className = 'toc-active-indicator';
    indicator.setAttribute('aria-hidden', 'true');
    nav.append(indicator);

    const updateIndicator = () => {
      const active =
        nav.querySelector('a[aria-current]') ||
        nav.querySelector('a.current') ||
        nav.querySelector('a.is-current');

      if (!(active instanceof HTMLElement)) {
        indicator.toggleAttribute('data-visible', false);
        return;
      }

      const navRect = nav.getBoundingClientRect();
      const activeRect = active.getBoundingClientRect();
      indicator.style.transform = `translateY(${activeRect.top - navRect.top}px)`;
      indicator.style.height = `${activeRect.height}px`;
      indicator.toggleAttribute('data-visible', true);
    };

    updateIndicator();
    new MutationObserver(updateIndicator).observe(nav, {
      attributes: true,
      subtree: true,
      attributeFilter: ['aria-current', 'class'],
    });
    window.addEventListener('resize', updateIndicator);
    document.addEventListener('scroll', updateIndicator, { passive: true });
  };

  setupTocIndicator();
  document.addEventListener('astro:page-load', setupTocIndicator);
</script>

<style>
  .site-header {
    width: 100%;
    background: var(--sl-color-bg-nav);
  }

  /* ── Main bar ── */
  .header-bar {
    display: flex;
    align-items: center;
    height: 3.5rem;
    padding: 0 1rem;
    gap: 1rem;
  }
  @media (min-width: 50em) {
    .header-bar { height: 4rem; }
  }

  .site-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo-img { height: 1.875rem; width: auto; }
  .logo-dark { display: none; }
  :global(:root[data-theme='dark']) .logo-light { display: none; }
  :global(:root[data-theme='dark']) .logo-dark { display: block; }

  /* ── Desktop nav ── */
  .main-nav {
    display: none;
    align-items: center;
    gap: 0.125rem;
    flex-shrink: 0;
  }
  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--sl-color-text);
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .nav-link:hover { background: var(--sl-color-bg-sidebar); color: var(--sl-color-text-accent); }
  .nav-link.is-active { color: var(--sl-color-text-accent); font-weight: 600; }

  /* ── Right cluster ── */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    min-width: 0;
  }
  .search-wrap {
    flex: 1 1 10rem;
    min-width: 8rem;
    width: clamp(8rem, 24vw, 14rem);
  }
  .search-divider { display: none; }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .menu-btn { display: flex; }
  .divider {
    width: 1px;
    height: 1.25rem;
    background: var(--sl-color-hairline-shade);
    margin: 0 0.125rem;
  }

  /* ── Shared icon button ── */
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    flex-shrink: 0;
  }
  .icon-btn:hover { color: var(--sl-color-white); background: var(--sl-color-bg-sidebar); }

  /* ── Mobile panel ── */
  .mobile-panel {
    border-top: 1px solid var(--sl-color-hairline-shade);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--sl-color-bg-nav);
  }
  .mobile-panel[hidden] { display: none; }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.625rem 0.75rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--sl-color-text);
    transition: background 0.15s;
  }
  .mobile-nav-link:hover { background: var(--sl-color-bg-sidebar); }
  .mobile-nav-link.is-active { color: var(--sl-color-text-accent); font-weight: 600; }

  @media (max-width: 419px) {
    .social-btn { display: none; }
    .header-actions .divider { display: none; }
  }

  /* ── Search button layout ── */
  @media (max-width: 37.999rem) {
    .header-right {
      gap: 0.5rem;
    }

    .search-wrap {
      flex: 0 0 2rem;
      min-width: 2rem;
      width: 2rem;
    }

    .search-wrap :global(button[data-open-modal]) {
      justify-content: center;
      width: 2rem;
      height: 2rem;
      padding: 0;
    }

    .search-divider {
      display: block;
      width: 1px;
      height: 1.25rem;
      background: var(--sl-color-hairline-shade);
      margin: 0 -0.125rem;
      flex-shrink: 0;
    }
  }

  /* ── Search bar breakpoint ── */
  @media (min-width: 38rem) {
    .search-wrap {
      min-width: 11rem;
    }

    .search-wrap :global(button[data-open-modal]) {
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding-inline-start: 0.75rem;
      padding-inline-end: 0.5rem;
      background-color: var(--sl-color-black);
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      width: 100%;
      max-width: 22rem;
    }

    .search-wrap :global(button[data-open-modal]:hover) {
      border-color: var(--sl-color-gray-2);
      color: var(--sl-color-white);
    }

    .search-wrap :global(button[data-open-modal] > span) {
      display: block;
    }

    .search-wrap :global(button[data-open-modal] > kbd) {
      display: flex !important;
    }

    .search-wrap :global(button[data-open-modal] > :last-child) {
      margin-inline-start: auto;
    }
  }

  /* ── Full nav breakpoint ── */
  @media (min-width: 1060px) {
    .header-bar { padding: 0 1.5rem; gap: 1.25rem; }
    .main-nav { display: flex; }
    .menu-btn { display: none; }
    /* hide mobile panel even if somehow open */
    .mobile-panel { display: none !important; }
  }
</style>
