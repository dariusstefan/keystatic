---
const isHome = Astro.url.pathname === '/';
const year = new Date().getFullYear();

const cols = [
  {
    heading: 'Project',
    links: [
      { label: 'About', href: '/about' },
      { label: "Who's Using", href: '/about/whos-using' },
      { label: 'Features', href: '/about/features' },
      { label: 'Versions', href: '/about/versions' },
      { label: 'Related Software', href: '/about/related-software' },
    ],
  },
  {
    heading: 'Get Started',
    links: [
      { label: 'Downloads', href: '/downloads' },
      { label: 'Documentation', href: '/documentation' },
      { label: 'Training', href: '/training' },
    ],
  },
  {
    heading: 'Community',
    links: [
      { label: 'Summits', href: '/community/summits' },
      { label: 'Clinics', href: '/community/clinics' },
      { label: 'Events', href: '/community/events' },
      { label: 'Foundation', href: '/community/foundation' },
      { label: 'Blog', href: 'https://blog.opensips.org', external: true },
    ],
  },
  {
    heading: 'Development',
    links: [
      { label: 'Overview', href: '/development' },
      { label: 'GitHub', href: 'https://github.com/OpenSIPS/opensips', external: true },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

{isHome && <footer class="not-content site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img class="logo-img logo-light" src="/opensips-logo.png" alt="OpenSIPS" height="28" />
        <img class="logo-img logo-dark" src="/opensips-dark.png" alt="" height="28" aria-hidden="true" />
      </a>
      <p class="footer-tagline">
        The open source SIP server for carrier-grade infrastructure.
      </p>
      <div class="footer-social">
        <a href="https://github.com/OpenSIPS/opensips" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/opensips/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.youtube.com/@OpenSIPS" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-cols">
      {cols.map((col) => (
        <div class="footer-col">
          <h4 class="footer-col-heading">{col.heading}</h4>
          <ul class="footer-col-links">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                  class="footer-link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} OpenSIPS Project. Released under GPLv2.</p>
  </div>
</footer>}

<style>
  .site-footer {
    background: var(--sl-color-bg-nav);
    border-top: 1px solid var(--sl-color-hairline-shade);
    margin-top: auto;
  }
  .footer-inner {
    max-width: 90rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 14rem 1fr;
      gap: 4rem;
    }
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-logo {
    display: inline-flex;
    text-decoration: none;
  }
  .logo-img { height: 1.75rem; width: auto; }
  .logo-dark { display: none; }
  :global(:root[data-theme='dark']) .logo-light { display: none; }
  :global(:root[data-theme='dark']) .logo-dark { display: block; }
  .footer-tagline {
    font-size: 0.8125rem;
    opacity: 0.6;
    line-height: 1.5;
    margin: 0;
    max-width: 18rem;
  }
  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    opacity: 0.6;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .footer-social a:hover { opacity: 1; }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .footer-cols { grid-template-columns: repeat(4, 1fr); }
  }
  .footer-col-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.5;
    margin: 0 0 0.75rem;
  }
  .footer-col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-link {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--sl-color-text);
    opacity: 0.75;
    transition: opacity 0.15s;
  }
  .footer-link:hover { opacity: 1; }
  .footer-bottom {
    border-top: 1px solid var(--sl-color-hairline-shade);
    padding: 1rem 1.5rem;
    text-align: center;
  }
  .footer-bottom p {
    font-size: 0.8125rem;
    opacity: 0.5;
    margin: 0;
  }
</style>
