---
import { getCollection } from 'astro:content';
import VersionSelector from '~/components/modules/VersionSelector.astro';
import { VERSIONS } from '~/config/module-versions';

const PAGE_TITLE_ID = '_top';

const { id } = Astro.locals.starlightRoute;
const parts = id.split('/');
// Module pages have the form: modules/<version-slug>/<module-name>
const isModulePage = parts[0] === 'modules' && parts.length === 3;

let moduleName: string | undefined;
let currentSlug: string | undefined;
let availableVersions = VERSIONS;

if (isModulePage) {
  currentSlug = parts[1];
  moduleName = parts[2];

  const allDocs = await getCollection('docs');
  const availableSlugs = allDocs
    .filter((e) => {
      const p = e.id.split('/');
      return p[0] === 'modules' && p.length === 3 && p[2] === moduleName;
    })
    .map((e) => e.id.split('/')[1]);

  availableVersions = VERSIONS.filter((v) => availableSlugs.includes(v.slug));
}
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

{isModulePage && moduleName && currentSlug && (
  <VersionSelector module={moduleName} currentSlug={currentSlug} versions={availableVersions} />
)}

{isModulePage && currentSlug && currentSlug !== 'devel' && (
  <link rel="preload" as="fetch" href={`/sidebar/${currentSlug}.json`} crossorigin="anonymous" />
  <script define:vars={{ currentSlug }}>
    async function rebuildSidebar() {
      const res = await fetch(`/sidebar/${currentSlug}.json`);
      if (!res.ok) return;
      const sidebarModules = await res.json();

      const templateLink = document.querySelector('nav a[href*="/modules/devel/"]');
      if (!templateLink) return;
      const templateLi = templateLink.closest('li');
      const container = templateLi?.parentElement;
      if (!container || !templateLi) return;

      const newItems = sidebarModules.map(({ module, title }) => {
        const href = `${window.location.origin}/modules/${currentSlug}/${module}`;
        const li = templateLi.cloneNode(true);
        const a = li.querySelector('a');
        if (!a) return li;
        a.setAttribute('href', href);
        a.textContent = title;
        const isCurrent =
          window.location.pathname === `/modules/${currentSlug}/${module}` ||
          window.location.pathname === `/modules/${currentSlug}/${module}/`;
        if (isCurrent) {
          a.setAttribute('aria-current', 'page');
        } else {
          a.removeAttribute('aria-current');
        }
        return li;
      });

      container.replaceChildren(...newItems);
    }

    rebuildSidebar();
    document.addEventListener('astro:after-swap', rebuildSidebar);
  </script>
)}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
