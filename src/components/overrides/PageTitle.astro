---
import { getCollection } from 'astro:content';
import VersionSelector from '~/components/modules/VersionSelector.astro';
import { VERSIONS } from '~/config/module-versions';

const PAGE_TITLE_ID = '_top';

const { id } = Astro.locals.starlightRoute;
const parts = id.split('/');
// Module pages have the form: modules/<version-slug>/<module-name>
const isModulePage = parts[0] === 'modules' && parts.length === 3;

let moduleName: string | undefined;
let currentSlug: string | undefined;
let availableVersions = VERSIONS;
let sidebarModules: { module: string; title: string }[] = [];

if (isModulePage) {
  currentSlug = parts[1];
  moduleName = parts[2];

  const allDocs = await getCollection('docs');

  const availableSlugs = allDocs
    .filter((e) => {
      const p = e.id.split('/');
      return p[0] === 'modules' && p.length === 3 && p[2] === moduleName;
    })
    .map((e) => e.id.split('/')[1]);

  availableVersions = VERSIONS.filter((v) => availableSlugs.includes(v.slug));

  // Build the full module list for the current version (for sidebar rebuilding)
  if (currentSlug !== 'devel') {
    sidebarModules = allDocs
      .filter((e) => {
        const p = e.id.split('/');
        return p[0] === 'modules' && p.length === 3 && p[1] === currentSlug && !!e.data.title;
      })
      .map((e) => ({ module: e.id.split('/')[2], title: e.data.title }))
      .sort((a, b) => a.module.localeCompare(b.module));
  }
}
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

{isModulePage && moduleName && currentSlug && (
  <VersionSelector module={moduleName} currentSlug={currentSlug} versions={availableVersions} />
)}

{isModulePage && currentSlug && currentSlug !== 'devel' && sidebarModules.length > 0 && (
  <script define:vars={{ currentSlug, sidebarModules }}>
    function rebuildSidebar() {
      // Find any sidebar link pointing to /modules/ to locate the container
      const templateLink = document.querySelector('nav a[href*="/modules/devel/"]');
      if (!templateLink) return;

      const templateLi = templateLink.closest('li');
      const container = templateLi?.parentElement;
      if (!container || !templateLi) return;

      // Build new <li> elements by cloning the template structure
      const newItems = sidebarModules.map(({ module, title }) => {
        const href = `/modules/${currentSlug}/${module}`;
        const li = templateLi.cloneNode(true);
        const a = li.querySelector('a');
        if (!a) return li;
        a.setAttribute('href', href);
        a.textContent = title;
        const isCurrent =
          window.location.pathname === href ||
          window.location.pathname === `${href}/`;
        if (isCurrent) {
          a.setAttribute('aria-current', 'page');
        } else {
          a.removeAttribute('aria-current');
        }
        return li;
      });

      container.replaceChildren(...newItems);
    }

    rebuildSidebar();
    document.addEventListener('astro:after-swap', rebuildSidebar);
  </script>
)}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
