---
import { getCollection } from 'astro:content';
import VersionSelector from '~/components/modules/VersionSelector.astro';
import { VERSIONS } from '~/config/module-versions';

const PAGE_TITLE_ID = '_top';

const { id } = Astro.locals.starlightRoute;
const parts = id.split('/');
// Module pages have the form: modules/<version-slug>/<module-name>
const isModulePage = parts[0] === 'modules' && parts.length === 3;

let moduleName: string | undefined;
let currentSlug: string | undefined;
let availableVersions = VERSIONS;

if (isModulePage) {
  currentSlug = parts[1];
  moduleName = parts[2];

  const allDocs = await getCollection('docs');
  const availableSlugs = allDocs
    .filter((e) => {
      const p = e.id.split('/');
      return p[0] === 'modules' && p.length === 3 && p[2] === moduleName && !e.data.sidebar?.hidden;
    })
    .map((e) => e.id.split('/')[1]);

  availableVersions = VERSIONS.filter((v) => availableSlugs.includes(v.slug));
}
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

{Astro.locals.starlightRoute.entry.data.subtitle && Astro.locals.starlightRoute.entry.data.subtitleHref && (
  <p class="page-subtitle">
    <span class="page-subtitle-label">View module:</span>{' '}
    <a href={Astro.locals.starlightRoute.entry.data.subtitleHref}>{Astro.locals.starlightRoute.entry.data.subtitle}</a>
  </p>
)}

{Astro.locals.starlightRoute.entry.data.subtitle && !Astro.locals.starlightRoute.entry.data.subtitleHref && (
  <p class="page-subtitle">{Astro.locals.starlightRoute.entry.data.subtitle}</p>
)}

{Astro.locals.starlightRoute.entry.data.author && (
  <p class="page-author">{Astro.locals.starlightRoute.entry.data.author}</p>
)}

{isModulePage && moduleName && currentSlug && (
  <VersionSelector module={moduleName} currentSlug={currentSlug} versions={availableVersions} />
)}

{isModulePage && currentSlug && currentSlug !== 'devel' && (
  <link rel="preload" as="fetch" href={`/sidebar/${currentSlug}.json`} crossorigin="anonymous" />
  <script define:vars={{ currentSlug }}>
    async function rebuildSidebar() {
      const res = await fetch(`/sidebar/${currentSlug}.json`);
      if (!res.ok) return;
      const sidebarModules = await res.json();

      const templateLink = document.querySelector('nav a[href*="/modules/devel/"]');
      if (!templateLink) return;
      const templateLi = templateLink.closest('li');
      const container = templateLi?.parentElement;
      if (!container || !templateLi) return;

      const newItems = sidebarModules.map(({ module, title }) => {
        const href = `${window.location.origin}/modules/${currentSlug}/${module}`;
        const li = templateLi.cloneNode(true);
        const a = li.querySelector('a');
        if (!a) return li;
        a.setAttribute('href', href);
        a.textContent = title;
        const isCurrent =
          window.location.pathname === `/modules/${currentSlug}/${module}` ||
          window.location.pathname === `/modules/${currentSlug}/${module}/`;
        if (isCurrent) {
          a.setAttribute('aria-current', 'page');
        } else {
          a.removeAttribute('aria-current');
        }
        return li;
      });

      container.replaceChildren(...newItems);
    }

    rebuildSidebar();
    document.addEventListener('astro:after-swap', rebuildSidebar);
  </script>
)}

<script>
  function numberHeadings() {
    const content = document.querySelector('.sl-markdown-content');
    if (!content) return;
    let h2 = 0, h3 = 0, h4 = 0;
    content.querySelectorAll('h2, h3, h4').forEach((el) => {
      if (el.tagName === 'H2') {
        h2++; h3 = 0; h4 = 0;
        el.setAttribute('data-num', `${h2}.`);
      } else if (el.tagName === 'H3') {
        h3++; h4 = 0;
        el.setAttribute('data-num', `${h2}.${h3}`);
      } else {
        h4++;
        el.setAttribute('data-num', `${h2}.${h3}.${h4}`);
      }
    });
  }
  document.addEventListener('DOMContentLoaded', numberHeadings);
  document.addEventListener('astro:after-swap', numberHeadings);
</script>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }

  .page-subtitle {
    margin-top: 0.4rem;
    margin-bottom: 0;
    padding-inline: 2rem;
    font-size: var(--sl-text-lg);
    font-weight: 400;
    color: var(--sl-color-gray-2);
    line-height: 1.4;
  }

  .page-subtitle-label {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-base);
  }

  .page-author {
    margin-top: 0.6rem;
    margin-bottom: 0;
    padding-inline: 2rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
</style>
