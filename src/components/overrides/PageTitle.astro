---
import { getCollection } from 'astro:content';
import VersionSelector from '~/components/modules/VersionSelector.astro';
import { VERSIONS, LATEST_VERSION, slugToBranch, branchToSlug } from '~/config/module-versions';

const PAGE_TITLE_ID = '_top';

const { id } = Astro.locals.starlightRoute;
const isModulePage = id.startsWith('modules/');

let moduleName: string | undefined;
let version: string | undefined;
let availableVersions = VERSIONS;

if (isModulePage) {
  const rest = id.slice('modules/'.length);
  const slash = rest.indexOf('/');
  if (slash === -1) {
    moduleName = rest;
    version = LATEST_VERSION.branch;
  } else {
    moduleName = rest.slice(0, slash);
    version = slugToBranch(rest.slice(slash + 1));
  }

  if (moduleName) {
    const allDocs = await getCollection('docs');
    const hasLatest = allDocs.some((e) => e.id === `modules/${moduleName}`);
    const versionedSlugs = allDocs
      .filter((e) => e.id.startsWith(`modules/${moduleName}/`))
      .map((e) => e.id.slice(`modules/${moduleName}/`.length));

    availableVersions = VERSIONS.filter((v) =>
      v.isLatest ? hasLatest : versionedSlugs.includes(branchToSlug(v.branch))
    );
  }
}
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

{isModulePage && moduleName && version && (
  <VersionSelector module={moduleName} version={version} versions={availableVersions} />
)}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
