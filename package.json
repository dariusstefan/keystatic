{
  "name": "src",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "resolve:toc": "python3 scripts/resolve-toc-anchors.py",
    "resolve:module-links": "python3 scripts/resolve-module-links.py",
    "prebuild": "python3 scripts/resolve-toc-anchors.py && python3 scripts/resolve-module-links.py",
    "generate:modules": "python3 scripts/generate-module-docs.py",
    "generate:modules:all": "python3 scripts/generate-module-docs.py --all-versions",
    "generate:manual": "python3 scripts/generate-manual-docs.py",
    "generate:manual:all": "python3 scripts/generate-manual-docs.py --all-versions",
    "generate:flat": "python3 scripts/generate-flat-docs.py",
    "generate:contributors": "python3 scripts/generate-contributors.py",
    "populate:fork": "python3 scripts/populate-fork.py",
    "populate:fork:dry": "python3 scripts/populate-fork.py --dry-run",
    "populate:fork:manual": "python3 scripts/populate-fork-manual.py",
    "populate:fork:manual:dry": "python3 scripts/populate-fork-manual.py --dry-run"
  },
  "dependencies": {
    "@astrojs/markdoc": "^1.0.5",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/node": "^10.1.1",
    "@astrojs/react": "^5.0.5",
    "@astrojs/starlight": "^0.39.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@iconify-json/tabler": "^1.2.35",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.50",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "astro-icon": "^1.1.5",
    "cheerio": "^1.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-heading-id": "^1.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "daisyui": "^5.5.19"
  }
}
