diff:1747309821:1747306854:=815c815%0a%3c $sdp.line(a=ptime[1]) # "a=ptime" line at index 1%0a---%0a> $sdp.line(a=ptime[1])   # "a=ptime" line at index 1%0a839,842c839,842%0a%3c $sdp.stream(/a=ptime);         # first “a=ptime” line from Stream #0 ("m=", matching any stream type)%0a%3c $sdp.stream([1]/a=ptime);      # first “a=ptime” line from Stream #1 ("m=", matching any stream type))%0a%3c $sdp.stream(audio[1]/a=ptime); # first “a=ptime” line from Audio Stream #1 ("m=audio...")%0a%3c $sdp.stream(a[1]/a=ptime);     # first “a=ptime” line from Audio Stream #1 ("m=a...")%0a---%0a> $sdp.stream(/a=ptime);         # first “a=ptime” line from Stream #0 (any stream type)%0a> $sdp.stream([1]/a=ptime);      # first “a=ptime” line from Stream #1 (any stream type)%0a> $sdp.stream(audio[1]/a=ptime); # first “a=ptime” line from Audio ("m=audio...") Stream #1%0a> $sdp.stream(a[1]/a=ptime);     # first “a=ptime” line from Audio ("m=a...") Stream #1%0a850,880d849%0a%3c @]%0a%3c %0a%3c [[#sdp.session]]%0a%3c !!!! SDP body session - $sdp.session [[#sdp.session|&#x1F517;]]%0a%3c %0a%3c '''$sdp.session''' - Read/Write reference to the SDP body session, with filtering support%0a%3c %0a%3c [@%0a%3c # Within the SDP session (i.e. until the 1st "m=" line), you can first filter by line...%0a%3c $sdp.session(a=ptime);            # 1st “a=ptime” line at Session level%0a%3c $sdp.session(a=ptime[0]);         # same as above%0a%3c $sdp.session(a=ptime[1]);         # 2nd “a=ptime” line at Session level%0a%3c $sdp.session(a=ptime[0]) = NULL;  # delete 1st “a=ptime” line at Session level%0a%3c %0a%3c # ... but also filter and edit by token:%0a%3c $sdp.session(a=rtpmap/telephone-event\/) = "8000";  # Match 1st "a=rtpmap" line which describes telephone-event at Session level, and force bitrate to 8000%0a%3c @]%0a%3c %0a%3c %0a%3c [[#sdp.stream.idx]]%0a%3c !!!! SDP line index - $sdp.stream.idx [[#sdp.stream.idx|&#x1F517;]]%0a%3c %0a%3c '''$sdp.stream.idx''' - Read-Only reference to the index of the matched SDP stream.  Yields NULL on no-match.%0a%3c %0a%3c This variable is especially useful in order to match a line having one specific attribute (e.g. "the rtpmap= line for PCMU codec"), then changing a different attribute within the same stream.  Example:%0a%3c %0a%3c [@%0a%3c $var(line_idx) = $sdp.stream.idx(video/a=fmtp/packetization-mode=); # locate index of first "a=fmtp" line, containing a packetization-mode= attribute%0a%3c $var(data) = $sdp.line([$var(line_idx)]); # grab the full line data%0a%3c ... perform processing on that line ...%0a%3c $sdp.line([$var(line_idx)]) = $var(data); # re-write the line%0a
